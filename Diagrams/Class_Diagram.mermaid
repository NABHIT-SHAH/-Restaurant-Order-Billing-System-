    class Restaurant {
        -MenuItem** menuItems
        -Customer* customers
        -Order* orders
        -Bill* bills
        -int menuCount, customerCount, orderCount, billCount
        -int menuCapacity, customerCapacity, orderCapacity, billCapacity
        -FileManager fileManager
        -string dataPath

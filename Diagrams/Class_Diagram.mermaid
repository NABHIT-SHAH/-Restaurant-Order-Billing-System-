    MenuItem <|-- FoodItem : Inheritance
    MenuItem <|-- BeverageItem : Inheritance
    Restaurant o-- MenuItem : Aggregation (MenuItem**)
    Restaurant o-- Customer : Dynamic Array (Customer*)
    Restaurant o-- Order : Dynamic Array (Order*)
    Restaurant o-- Bill : Dynamic Array (Bill*)
    Restaurant --> FileManager : Uses (File I/O)
    Order --> Customer : References (customerId)
    Order --> MenuItem : References (itemIds)
    Bill --> Order : References (orderId)
    Bill --> Customer : References (customerId)

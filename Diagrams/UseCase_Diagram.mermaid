    UC6["Manage Customers (CRUD)"]
    UC7["Generate Statistical Reports"]
    UC8["Save & Load Data Persistence"]

    Customer --> UC1
    Customer --> UC2
    Customer --> UC3
    Customer --> UC4

    Manager --> UC1
    Manager --> UC2
    Manager --> UC3
    Manager --> UC4
    Manager --> UC5
    Manager --> UC6
    Manager --> UC7
    Manager --> UC8

    UC2 -.->|"«include»"| UC1
    UC2 -.->|"«include»"| UC3
